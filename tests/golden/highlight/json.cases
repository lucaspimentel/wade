# Highlight parity cases extracted from tests/Wade.Tests/JsonLanguageTests.cs
# plus hand-written cases. Each %%%% block is tokenized from state 0.
file: sample.json
%%%%
"key": "value"
%%%%
"key": 42
%%%%
"key": true
%%%%
"key": false
%%%%
"key": null
%%%%
{ "a": 1 }
%%%%
{ "a": { "b": 1 } }
%%%%
{
  "name": "wade",
  "version": 1.2e-3,
  "neg": -42,
  "flags": [true, false, null],
  "nested": { "key": "va\"lue", "arr": [1, 2, {"deep": "x"}] },
  "escaped \\ key": "end"
}
%%%%
"unterminated: "value
%%%%
[ "a", "b" ]
%%%%
truefalse nullx -

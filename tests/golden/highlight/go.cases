package main

import "fmt"

type Point struct{ X, Y float64 }

func main() {
	p := Point{X: 1.5, Y: 2}
	raw := `C:\no\escapes`
	unterminated := `open
	for i := range make([]int, 3) {
		fmt.Println(i, p, raw, nil, iota)
	}
}

#pragma once
template <typename T>
class Box final : public Base {
public:
    explicit Box(T v) noexcept : value_(std::move(v)) {}
    constexpr auto get() const -> const T& { return value_; }
private:
    std::unique_ptr<std::vector<std::string>> items_ = nullptr;
};

<#
.SYNOPSIS
  Block help comment
#>
function Get-Thing {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)][string]$Name
    )
    if ($Name -eq $null -or $Name -like "*x*") { return $false }
    Write-Host "Name: $Name" # comment
    foreach ($i in 1..3) { $i * 2 }
}

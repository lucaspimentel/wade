import os
from typing import Optional

@dataclass(frozen=True)
class Item:
    """Docstring on
    several lines."""
    name: str = 'x'

    @property
    def path(self) -> Optional[str]:
        raw = r"C:\temp"
        fmt = f"{self.name!r}"
        data = b'\x00\xff'
        return os.path.join(raw, fmt) if self.name is not None else None

# comment with "quotes"

#include <stdio.h>
#define MAX(a, b) ((a) > (b) ? (a) : (b))

/* multi-line
 * comment */
static inline int add(int a, int b) { return a + b; }

int main(void) {
    char *s = "hi\n";
    size_t n = sizeof(s);
    for (unsigned i = 0u; i < 10; i++) printf("%d\n", i);
    return NULL == s ? 1 : 0;
}

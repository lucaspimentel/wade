use std::collections::HashMap;

#[derive(Debug, Clone)]
pub struct Wrapper<'a> {
    name: &'a str,
    map: HashMap<String, Vec<u8>>,
}

impl<'a> Wrapper<'a> {
    pub fn new(name: &'a str) -> Self {
        let c = 'x';

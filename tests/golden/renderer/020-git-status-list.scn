# Git status column: icons and coloring by status flags
size 80 25
list main
dir src 2024-01-02T03:04:00
file README.md 1234 2024-02-03T14:30:00
file photo.jpg 2048 2023-12-31T23:59:00
file app.rs 3456 2024-05-06T07:08:00
endlist
gitstatuses
gs "C:\fixture\src" untracked
gs "C:\fixture\README.md" staged+modified
gs "C:\fixture\photo.jpg" modified
gs "C:\fixture\app.rs" untracked
endgitstatuses
layout 3pane
filelist center main 1 0 active icons size date
flush
gsoff
filelist center main 1 0 active icons size date
flush
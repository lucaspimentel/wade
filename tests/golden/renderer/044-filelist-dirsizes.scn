# Inline directory sizes: computed sizes, directories still loading, and an
# empty map where every directory is loading; selected and unselected rows.
size 100 20
list main
dir alpha 2024-01-02T03:04:00
dir beta 2024-01-02T03:04:00
dir gamma 2024-01-02T03:04:00
dir linked 2024-01-02T03:04:00 link=C:\target

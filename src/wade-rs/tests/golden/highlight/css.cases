.c {
  a: rgb(255, 0, 0); b: rgba(0,0,255,.5); c: rgb(255 0 0 / 50%); d: rgb(100% 0% 0%);
  e: hsl(120, 100%, 50%); f: hsl(120deg 100% 25%); g: hsl(0.5turn 100% 50%); h: HSLA(240,100%,50%,0.3);
  i: rgb(var(--r), 0, 0); j: rgb(1, 2); k: rgb(1, 2, 3
}
%%%%
.n {
  color: red; border: 1px solid RebeccaPurple; --accent: tomato;
  background: url(red.png) transparent; content: "red"; x: red-ish; y: #red;
  z: #abc rgb(0 0 0) navy;
}
%%%%
.red { color: blue }
%%%%
.a { /* comment
  spans */ color: #abc; }
%%%%
target: sample.scss
.a {
  &:hover #abc { color: red; }
  .b { color: $red; }
}
%%%%
target: sample.sass
.a
  color: #abc
  background: rgb(0, 128, 0)
  &:hover
    border: 1px solid navy

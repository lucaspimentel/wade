# Rust-owned CSS highlight cases (KNOWN_DEVIATIONS.md): the C# cases from
# tests/golden/highlight/css.cases plus cases for the Rust extensions. Each
# %%%% block is tokenized from state 0; regenerate the golden with
# WADE_UPDATE_GOLDENS=1 cargo test --test highlight_golden.
file: sample.css
%%%%
/* start
middle
end */
%%%%
color: red;
%%%%
/* comment */
%%%%
content: "text";
%%%%
{ color: red; }
%%%%
color: #e4e4e4;
%%%%
color: #f00;
%%%%
color: #ff000080;
%%%%
color: #f008;
%%%%
background: linear-gradient(#abc, #def);
%%%%
#main { color: red; }
%%%%
/* #ff0000 */
%%%%
content: "#ff0000";
%%%%
color: #gg0000;
%%%%
color: #12345;
%%%%
color: #1234567;
%%%%
color: #12;
%%%%
color: #f00000;
%%%%
/* Theme */
:root {
  --accent: #3366CC;
  --muted: #abc8;
}
a:hover #abc { color: #fff; }
#main .card > p::first-line {
  color: #12345678;
  background: url("img/bg.png") no-repeat, #000 !important;
  border: 1px solid #ABCDEF; font-family: 'Fira Code', monospace;
}
@media (min-width: 600px) { .x { color: #0f0; } }
.bad { color: #gg0000; width: #12; margin: #12345; top: #1234567; }
%%%%
.multi {
  color:
    #abc;
}
%%%%
/* unterminated
still comment */ .after { color: #f00 }
%%%%
x { a: #fff b: #000 }
%%%%
x{color:#FFF;}
%%%%

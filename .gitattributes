* text=auto

# Set line endings to LF, even on Windows. Otherwise, execution within Docker fails.
# See https://help.github.com/articles/dealing-with-line-endings/
*.sh text eol=lf
*.bash text eol=lf
# Golden fixtures are compared byte-for-byte by Rust and C# tests; keep LF.
tests/golden/** text eol=lf
# Preview fixtures exercise exact bytes (CRLF, CR, BOMs, binary, archives); never convert.
tests/golden/preview/files/** -text
tests/golden/preview/archives/** -text
tests/golden/preview/shortcuts/** -text
tests/golden/markdown/corpus/** -text
